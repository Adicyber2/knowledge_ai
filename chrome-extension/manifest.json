{
  "manifest_version": 3,
  "name": "AI Knowledge Vault",
  "version": "1.0.0",
  "description": "Save webpages, articles, selected text and YouTube videos directly to your AI Knowledge Vault.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://knowledge-backend-jzuz.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to AI Knowledge Vault"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
